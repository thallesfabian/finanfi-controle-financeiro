generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum BillStatus {
  PAID
  PENDING
  OVERDUE
}

enum GoalType {
  REVENUE
  NET_REVENUE
  SAVINGS
  CONTINGENCY
  OTHER
}

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  categories Category[]
  transactions Transaction[]
  bills Bill[]
  vehicles Vehicle[]
  journeys Journey[]
  fuelings Fueling[]
  goals Goal[]
  vaults Vault[]
  settings Setting?
  monthlyPlans MonthlyPlan[]
}
model Category {
  id String @id @default(cuid())
  name String
  type TransactionType
  color String @default("#6C5CE7")
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  transactions Transaction[]
  @@unique([userId,name,type])
}
model Transaction {
  id String @id @default(cuid())
  description String
  amount Decimal @db.Decimal(12,2)
  date DateTime
  type TransactionType
  paymentMethod String?
  notes String?
  userId String
  categoryId String?
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  category Category? @relation(fields:[categoryId], references:[id], onDelete:SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId,date,type])
}
model Bill {
  id String @id @default(cuid())
  name String
  amount Decimal @db.Decimal(12,2)
  dueDay Int
  category String
  recurring Boolean @default(true)
  month Int?
  year Int?
  paymentMethod String?
  status BillStatus @default(PENDING)
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  payments BillPayment[]
  monthOverrides BillMonthOverride[]
}

model BillMonthOverride {
  id String @id @default(cuid())
  month Int
  year Int
  name String
  amount Decimal @db.Decimal(12,2)
  dueDay Int
  category String
  paymentMethod String?
  billId String
  bill Bill @relation(fields:[billId], references:[id], onDelete:Cascade)
  @@unique([billId, month, year])
}

model MonthlyPlan {
  id String @id @default(cuid())
  month Int
  year Int
  income Decimal @default(0) @db.Decimal(12,2)
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@unique([userId, month, year])
}

model BillPayment {
  id String @id @default(cuid())
  month Int
  year Int
  paidAt DateTime @default(now())
  billId String
  bill Bill @relation(fields:[billId], references:[id], onDelete:Cascade)
  @@unique([billId, month, year])
}
model Vehicle {
  id String @id @default(cuid())
  name String
  avgConsumption Decimal? @db.Decimal(8,2)
  financingMonthly Decimal? @db.Decimal(12,2)
  insuranceMonthly Decimal? @db.Decimal(12,2)
  maintenanceMonthly Decimal? @db.Decimal(12,2)
  annualTax Decimal? @db.Decimal(12,2)
  depreciationMonthly Decimal? @db.Decimal(12,2)
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  journeys Journey[]
  fuelings Fueling[]
}
model Journey {
  id String @id @default(cuid())
  date DateTime
  startTime DateTime
  endTime DateTime
  startKm Decimal @db.Decimal(10,1)
  endKm Decimal @db.Decimal(10,1)
  uber Decimal @default(0) @db.Decimal(12,2)
  ninetyNine Decimal @default(0) @db.Decimal(12,2)
  inDrive Decimal @default(0) @db.Decimal(12,2)
  otherApps Decimal @default(0) @db.Decimal(12,2)
  tips Decimal @default(0) @db.Decimal(12,2)
  otherIncome Decimal @default(0) @db.Decimal(12,2)
  userId String
  vehicleId String?
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  vehicle Vehicle? @relation(fields:[vehicleId], references:[id], onDelete:SetNull)
  costs JourneyCost[]
}
model JourneyCost {
  id String @id @default(cuid())
  category String
  amount Decimal @db.Decimal(12,2)
  notes String?
  journeyId String
  journey Journey @relation(fields:[journeyId], references:[id], onDelete:Cascade)
}
model Fueling {
  id String @id @default(cuid())
  date DateTime
  liters Decimal @db.Decimal(10,3)
  pricePerLiter Decimal @db.Decimal(10,3)
  total Decimal @db.Decimal(12,2)
  odometer Decimal? @db.Decimal(10,1)
  userId String
  vehicleId String?
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  vehicle Vehicle? @relation(fields:[vehicleId], references:[id], onDelete:SetNull)
}
model Goal {
  id String @id @default(cuid())
  name String
  type GoalType
  target Decimal @db.Decimal(12,2)
  current Decimal @default(0) @db.Decimal(12,2)
  month Int?
  year Int?
  workDays Int?
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
}
model Vault {
  id String @id @default(cuid())
  name String
  target Decimal @db.Decimal(12,2)
  balance Decimal @default(0) @db.Decimal(12,2)
  targetDate DateTime?
  color String @default("#6C5CE7")
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
}
model Setting {
  id String @id @default(cuid())
  monthlySalary Decimal? @db.Decimal(12,2)
  avgFuelPrice Decimal? @db.Decimal(10,3)
  onboardingDone Boolean @default(false)
  userId String @unique
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
}
